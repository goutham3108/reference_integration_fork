@@ -31,6 +31,26 @@ docker run -d --restart=always -e RUNTIME_PREFIX="Kit-" -e RUNTIME_NAME="MyRunti
 
 Video instruction: [https://youtu.be/HQrsGY7XLU4](https://youtu.be/HQrsGY7XLU4)
 
+### Raspberry Pi ARM64 With MW COM
+
+Build from this directory; all required sources and configuration files are local:
+
+```bash
+docker buildx build --builder default --platform linux/arm64 --load \
+	-t sdv-runtime:raspberrypi .
+docker run -d --init --name sdv-runtime-pi --shm-size=256m \
+	-p 127.0.0.1:55556:55555 -p 127.0.0.1:3090:3090 \
+	-e RUNTIME_NAME=RaspberryPi-Python sdv-runtime:raspberrypi
+```
+
+ARM64 defaults to `DATABROKER_BACKEND=mw-com-dem-bin`; use
+`DATABROKER_BACKEND=databroker` to select the original binary instead. Only the
+selected backend is launched. The Python syncer, Python mocks, native Node.js,
+health check, and shutdown handling are retained; no C++ syncer is required.
+MW COM uses the packaged provider and SCORE JSON files, without `--vss`.
+External SCORE vehicle services and compatible IPC integration are still needed
+for live vehicle data; those services are not included in this image.
+
 ### Arguments for setting runtime name
 `$RUNTIME_NAME`: this is the ID to add your runtime to playground.digital.auto.
 `$RUNTIME_PREFIX`: (Optional) Custom prefix for the runtime ID. Default is "Runtime-". Set to empty string for no prefix.
diff --git a/start_services.sh b/start_services.sh
index 8c7e965..a87110b 100755
--- a/start_services.sh
+++ b/start_services.sh
@@ -10,7 +10,27 @@
 
 
 DISABLE_DATABROKER=${DISABLE_DATABROKER:-""}
-DATABROKER_ARGS=${DATABROKER_ARGS:-""}
+DATABROKER_BIN=/app/databroker
+MW_COM_DEM_BIN=/app/mw-com-dem-bin
+DATABROKER_BACKEND=${DATABROKER_BACKEND:-"mw-com-dem-bin"}
+case "$DATABROKER_BACKEND" in
+    databroker)
+        SELECTED_DATABROKER_BIN="$DATABROKER_BIN"
+        DATABROKER_ARGS=${DATABROKER_ARGS:-""}
+        ;;
+    mw-com-dem-bin)
+        SELECTED_DATABROKER_BIN="$MW_COM_DEM_BIN"
+        DATABROKER_ARGS=${DATABROKER_ARGS:-"--address 0.0.0.0:55555 \
+            --provider-config /home/dev/mw_com_provider/generated/mw_com_provider_config.json \
+            --score-config /home/dev/mw_com_config.json \
+            --include-vss-path Vehicle.Speed \
+            --include-vss-path Vehicle.Body.Lights.Beam.High.IsOn"}
+        ;;
+    *)
+        echo "ERROR: invalid DATABROKER_BACKEND '$DATABROKER_BACKEND' (expected databroker or mw-com-dem-bin)"
+        exit 1
+        ;;
+esac
 SYNCER_SERVER_URL=${SYNCER_SERVER_URL:-"https://kit.digitalauto.tech"}
 VSS_DATA=${VSS_DATA:-""}
 RUNTIME_NAME=${RUNTIME_NAME:-"VSS4.0"} # Display name on the playground
@@ -72,7 +92,12 @@ log_kit_manager_container "CONTAINER_STARTING" "user=$(id -u -n)"
 mosquitto -d -c /etc/mosquitto/mosquitto-no-auth.conf
 
 if [ -z "$DISABLE_DATABROKER" ]; then
-    /app/databroker $DATABROKER_ARGS & 
+    if [ ! -x "$SELECTED_DATABROKER_BIN" ]; then
+        echo "ERROR: $DATABROKER_BACKEND binary not found or not executable: $SELECTED_DATABROKER_BIN"
+        exit 1
+    fi
+    echo "Starting $DATABROKER_BACKEND: $SELECTED_DATABROKER_BIN"
+    "$SELECTED_DATABROKER_BIN" $DATABROKER_ARGS &
     DATABROKER_PID=$!
 fi
 
