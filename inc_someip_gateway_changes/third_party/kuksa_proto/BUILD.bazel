load("@@grpc+//bazel:cc_grpc_library.bzl", "cc_grpc_library")

proto_library(
    name = "kuksa_val_v1_types_proto",
    srcs = ["kuksa/val/v1/types.proto"],
    deps = ["@@protobuf+//:timestamp_proto"],
)

cc_proto_library(
    name = "kuksa_val_v1_types_cc_proto",
    deps = [":kuksa_val_v1_types_proto"],
)

proto_library(
    name = "kuksa_val_v1_proto",
    srcs = ["kuksa/val/v1/val.proto"],
    deps = [":kuksa_val_v1_types_proto"],
)

cc_proto_library(
    name = "kuksa_val_v1_cc_proto",
    deps = [":kuksa_val_v1_proto"],
)

cc_grpc_library(
    name = "kuksa_val_v1_cc_grpc",
    srcs = [":kuksa_val_v1_proto"],
    deps = [
        ":kuksa_val_v1_cc_proto",
        ":kuksa_val_v1_types_cc_proto",
    ],
    grpc_only = True,
    visibility = ["//visibility:public"],
)

proto_library(
    name = "kuksa_val_v2_types_proto",
    srcs = ["kuksa/val/v2/types.proto"],
    deps = ["@@protobuf+//:timestamp_proto"],
)

cc_proto_library(
    name = "kuksa_val_v2_types_cc_proto",
    deps = [":kuksa_val_v2_types_proto"],
)

proto_library(
    name = "kuksa_val_v2_proto",
    srcs = ["kuksa/val/v2/val.proto"],
    deps = [":kuksa_val_v2_types_proto"],
)

cc_proto_library(
    name = "kuksa_val_v2_cc_proto",
    deps = [":kuksa_val_v2_proto"],
)

cc_grpc_library(
    name = "kuksa_val_v2_cc_grpc",
    srcs = [":kuksa_val_v2_proto"],
    deps = [
        ":kuksa_val_v2_cc_proto",
        ":kuksa_val_v2_types_cc_proto",
    ],
    grpc_only = True,
    visibility = ["//visibility:public"],
)
