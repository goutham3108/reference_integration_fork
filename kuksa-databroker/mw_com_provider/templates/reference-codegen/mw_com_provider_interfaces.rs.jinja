{% import "macros" as macros -%}

{% macro event_type(ns, event) -%}
{%- if macros.is_builtin_json_type(event.datatype) == "true" -%}
{%- set sample_types = {"bool": "BoolSample", "u8": "U8Sample", "f32": "F32Sample", "String": "String16Sample"} -%}
{%- set rust_type = macros.to_rust_type(event.datatype) -%}
{%- if rust_type in sample_types -%}
crate::mw_com_provider_types::{{ ns.name }}::{{ sample_types[rust_type] }}
{%- else -%}
{{ macros.to_rust_type(event.datatype) }}
{%- endif -%}
{%- else -%}
crate::mw_com_provider_types::{{ ns.name }}::{{ macros.to_rust_type(event.datatype) }}
{%- endif -%}
{%- endmacro %}

{% macro render_namespace(ns) -%}
pub mod {{ ns.name }} {
    use score_com::{ProviderInfo, Publisher, Subscriber};

{% for intf in ns.interfaces | default([]) %}
    score_com::interface!(interface {{ intf.name }} {
        Id = "{{ intf.interface_id | default(intf.name) }}",
{% for event in intf.events | default([]) %}
        {{ event.name }}: Event<{{ event_type(ns, event) }}>,
{% endfor %}
    });
{% endfor %}
{% for child in ns.namespaces | default([]) %}
{{ render_namespace(child) }}
{% endfor %}
}
{% endmacro %}
{% for ns in json.namespaces | default([]) %}
{{ render_namespace(ns) }}
{% endfor %}