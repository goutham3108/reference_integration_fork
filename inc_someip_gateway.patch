-                [str(self._stackcollapse)],
-                input=perf_script.stdout,
-                capture_output=True,
-                check=True,
-            )
-            output = perf_data.with_suffix(".svg")
-            with output.open("wb") as svg:
-                subprocess.run(
-                    [str(self._flamegraph), "--title", perf_data.stem],
-                    input=folded.stdout,
-                    stdout=svg,
-                    check=True,
-                )
