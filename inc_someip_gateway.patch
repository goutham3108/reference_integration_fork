-    """Build a 16-byte FindService (Type 0) SD entry."""
-    ttl_3b = struct.pack(">I", ttl)[1:]  # 3 bytes big-endian
-    return (
-        bytes([0x00, 0x00, 0x00, 0x00])
-        + struct.pack(">HH", service_id, instance_id)
