index 00000000..4905c140
--- /dev/null
+++ b/quality/integration_testing/plugins/linux_qemu/qemu_test.py
@@ -0,0 +1,110 @@
+# *******************************************************************************
+# Copyright (c) 2026 Contributors to the Eclipse Foundation
+#
