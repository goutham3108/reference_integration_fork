-                    address=ipaddress.IPv4Address(subscriber_ip),
-                    l4proto=L4Protocols.UDP,
-                    port=udp_port,
-                )
-            )
-        if tcp_port is not None:
-            endpoint_opt.append(
-                IPv4EndpointOption(
-                    address=ipaddress.IPv4Address(subscriber_ip),
-                    l4proto=L4Protocols.TCP,
-                    port=tcp_port,
