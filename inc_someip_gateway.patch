-        # shellcheck disable=SC2312
-        VSOMEIP_LIB_DIR=$(find "${SCRIPT_DIR}/someipd.runfiles" \
-            -name "libvsomeip3.so*" -exec dirname {} \; 2>/dev/null | head -1)
