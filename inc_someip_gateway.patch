-    entry = SOMEIPSDEntry(
-        sd_type=SOMEIPSDEntryType.Subscribe,
-        service_id=service_id,
-        instance_id=instance_id,
-        major_version=major_version,
-        ttl=ttl,
-        minver_or_counter=eventgroup_id & 0xFFFF,
-        options_1=(endpoint_opt,),
