-    original_word: int = struct.unpack_from("!I", raw, _MINVER_OFFSET)[0]
-    patched_word: int = original_word | ((reserved_value & 0x0FFF) << 20)
-    struct.pack_into("!I", raw, _MINVER_OFFSET, patched_word)
