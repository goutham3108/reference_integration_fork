-    ttl_3b = struct.pack(">I", ttl)[1:]
-    return (
-        bytes([0x06, idx_opt, (num_opts << 4), 0x00])
-        + struct.pack(">HH", service_id, instance_id)
-        + bytes([major_version])
-        + ttl_3b
-        + reserved
-        + struct.pack(">H", eventgroup_id & 0xFFFF)
-    )
