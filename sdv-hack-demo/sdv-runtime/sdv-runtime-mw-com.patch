diff --git a/test/test_signal_writes.py b/test/test_signal_writes.py
new file mode 100644
index 0000000000000000000000000000000000000000..3cc43c80c5ab555cf4b2d56e9c58d8376b09bc90
--- /dev/null
+++ b/test/test_signal_writes.py
@@ -0,0 +1,172 @@
+import asyncio
+import os
+from pathlib import Path
+import sys
+import unittest
+from unittest.mock import AsyncMock, MagicMock, mock_open, patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "kuksa-syncer"))
+
+import syncer
+from grpc import RpcError
+from kuksa_client.grpc import Datapoint, EntryType, VSSClientError
+
+
+class SignalWriteTests(unittest.TestCase):
+    def setUp(self):
+        self.environment = patch.dict(os.environ, {"MOCK_SIGNAL": ""})
+        self.environment.start()
+        self.addCleanup(self.environment.stop)
+        self.client_factory = patch.object(syncer, "KClient")
+        self.client = self.client_factory.start().return_value.__enter__.return_value
+        self.addCleanup(self.client_factory.stop)
+        emit_patch = patch.object(syncer.sio, "emit", new_callable=AsyncMock)
+        self.emit = emit_patch.start()
+        self.addCleanup(emit_patch.stop)
+        client_id_patch = patch.object(syncer, "CLIENT_ID", "test-runtime", create=True)
+        client_id_patch.start()
+        self.addCleanup(client_id_patch.stop)
+
+    def command(self, cmd, data):
+        asyncio.run(syncer.messageToKit({
+            "cmd": cmd, "data": data, "request_from": "test-client",
+        }))
+        return self.emit.call_args.args[1]
+
+    def test_widget_publishes_current_for_every_entry_type(self):
+        for entry_type in (EntryType.ACTUATOR, EntryType.SENSOR, EntryType.ATTRIBUTE):
+            with self.subTest(entry_type=entry_type):
+                self.client.reset_mock()
+                self.client.get_metadata.return_value = {
+                    "Vehicle.Test": MagicMock(entry_type=entry_type),
+                }
+                syncer.writeSignalsValue({"Vehicle.Test": True})
+                self.client.set_current_values.assert_called_once()
+                values = self.client.set_current_values.call_args.args[0]
+                self.assertEqual(values["Vehicle.Test"].value, True)
+                self.client.set_target_values.assert_not_called()
+
+    def test_batch_keeps_client_supported_value_types(self):
+        expected = {
+            "Vehicle.Mode": "ECONOMY", "Vehicle.Light": False,
+            "Vehicle.Speed": 12.5, "Vehicle.Count": 2,
+            "Vehicle.Cells": [8.1, 8.2],
+        }
+        syncer.writeSignalsValue(expected)
+        self.client.set_current_values.assert_called_once()
+        actual = self.client.set_current_values.call_args.args[0]
+        self.assertEqual({key: value.value for key, value in actual.items()}, expected)
+        self.assertTrue(all(isinstance(value, Datapoint) for value in actual.values()))
+
+    def test_widget_acknowledges_success(self):
+        reply = self.command("write_signals_value", {"Vehicle.Mode": "ECONOMY"})
+        self.assertEqual(reply["result"], "Successful")
+        self.client.set_current_values.assert_called_once()
+
+    def test_signal_watch_publishes_without_mock_files_or_processes(self):
+        with patch.object(syncer, "modifyMockSignal") as modify, \
+                patch.object(syncer, "restartMockProvider") as restart:
+            data = [{"signal": "Vehicle.Mode", "value": "ECONOMY"}]
+            reply = self.command("set_mock_signals", data)
+            self.assertEqual(reply["result"], "Successful")
+            self.assertEqual(reply["data"], data)
+            self.client.set_current_values.assert_called_once()
+            self.assertEqual(
+                self.client.set_current_values.call_args.args[0]["Vehicle.Mode"].value,
+                "ECONOMY",
+            )
+            modify.assert_not_called()
+            restart.assert_not_called()
+
+    def test_enabled_mock_configuration_is_preserved(self):
+        with patch.dict(os.environ, {"MOCK_SIGNAL": "/tmp/configured-mocks.json"}), \
+                patch.object(syncer, "modifyMockSignal") as modify, \
+                patch.object(syncer, "listMockSignal", return_value=[]) as listing, \
+                patch.object(syncer, "restartMockProvider") as restart:
+            data = [{"signal": "Vehicle.Mode", "value": "NORMAL"}]
+            reply = self.command("set_mock_signals", data)
+            self.assertEqual(reply["result"], "Successful")
+            modify.assert_called_once_with(data)
+            listing.assert_called_once()
+            restart.assert_called_once()
+            self.client.set_current_values.assert_not_called()
+
+    def test_disabled_mock_subscription_does_not_open_files(self):
+        with patch("builtins.open", side_effect=AssertionError("mock file accessed")), \
+                patch.object(syncer, "restartMockProvider") as restart:
+            syncer.appendMockSignal(["Vehicle.Light"])
+            restart.assert_not_called()
+
+    def test_enabled_mock_list_can_be_cleared(self):
+        with patch.dict(os.environ, {"MOCK_SIGNAL": "/tmp/configured-mocks.json"}), \
+                patch.object(syncer, "modifyMockSignal") as modify, \
+                patch.object(syncer, "listMockSignal", return_value=[]), \
+                patch.object(syncer, "restartMockProvider"):
+            reply = self.command("set_mock_signals", [])
+            self.assertEqual(reply["result"], "Successful")
+            modify.assert_called_once_with([])
+            self.client.set_current_values.assert_not_called()
+
+    def test_disabled_mock_restart_does_not_start_or_stop_processes(self):
+        with patch.object(syncer, "startMockService") as start, \
+                patch.object(syncer, "stopMockService") as stop:
+            syncer.restartMockProvider()
+            start.assert_not_called()
+            stop.assert_not_called()
+
+    def test_broker_error_is_returned_for_both_write_commands(self):
+        for command, data in (
+            ("write_signals_value", {"Vehicle.Missing": True}),
+            ("set_mock_signals", [{"signal": "Vehicle.Missing", "value": True}]),
+        ):
+            with self.subTest(command=command):
+                self.client.set_current_values.side_effect = VSSClientError(
+                    {"code": 404, "reason": "not_found", "message": "Unknown signal"},
+                    [],
+                )
+                reply = self.command(command, data)
+                self.assertEqual(reply["result"], "Failed")
+                self.assertIn("Unknown signal", reply["error"])
+
+    def test_invalid_payloads_are_reported_without_writes(self):
+        for command, data in (
+            ("write_signals_value", []),
+            ("write_signals_value", {}),
+            ("set_mock_signals", [{"signal": "Vehicle.Mode"}]),
+            ("set_mock_signals", {"Vehicle.Mode": "ECONOMY"}),
+        ):
+            with self.subTest(command=command, data=data):
+                with patch.object(syncer, "modifyMockSignal"), \
+                        patch.object(syncer, "restartMockProvider"):
+                    reply = self.command(command, data)
+                self.assertEqual(reply["result"], "Failed")
+                self.client.set_current_values.assert_not_called()
+
+    def test_connection_and_type_errors_are_not_successful(self):
+        for error in (RpcError("Unavailable"), ValueError("Invalid boolean")):
+            with self.subTest(error=error):
+                self.client.set_current_values.side_effect = error
+                reply = self.command("write_signals_value", {"Vehicle.Light": "bad"})
+                self.assertEqual(reply["result"], "Failed")
+                self.assertIn(str(error), reply["error"])
+
+    def test_reset_uses_signal_objects_not_a_string(self):
+        content = '[{"signal": "Vehicle.Mode", "value": "NORMAL"}]'
+        with patch("builtins.open", mock_open(read_data=content)):
+            reply = self.command("reset_signals_value", {})
+        self.assertEqual(reply["result"], "Successful")
+        self.assertEqual(
+            self.client.set_current_values.call_args.args[0]["Vehicle.Mode"].value,
+            "NORMAL",
+        )
+
+    def test_missing_reset_file_is_reported(self):
+        with patch("builtins.open", side_effect=FileNotFoundError("No reset file")):
+            reply = self.command("reset_signals_value", {})
+        self.assertEqual(reply["result"], "Failed")
+        self.assertIn("No reset file", reply["error"])
+        self.client.set_current_values.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
