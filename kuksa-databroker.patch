+        server::serve_tcp(
+            grpc_addr,
+            grpc_broker,
+            &[Api::KuksaValV2],
+            Authorization::Disabled,
+            async move {
+                let _ = grpc_shutdown_rx.await;
+            },
+        )
+        .await
+        .map_err(|error| error.to_string())
+    });
+
+    let adapter = LolaScoreRuntimeAdapter::from_score_config_env()?;
